---
import Base from '../layouts/Base.astro';
import Preguntas from '../components/Preguntas.astro';
import { getServicios } from '../lib/contenido';
import { CATEGORIAS } from '../content.config';
import { NOMBRE_CATEGORIA, euros } from '../lib/util';

const servicios = await getServicios();
---

<Base titulo="Servicios y precios" descripcion="Consultas, vacunas, diagnóstico por imagen, cirugía e higiene para perros, gatos y conejos, con precio orientativo.">
  <div class="contenedor cabecera-pagina">
    <h1>Servicios y precios</h1>
    <p>Todo con su precio. Si hay que hacer pruebas o tratamientos, te damos un presupuesto antes de empezar.</p>
  </div>
  <section class="seccion" style="padding-top:24px">
    <div class="contenedor">
      <div class="servicios-lista">
        {CATEGORIAS.map((c) => (
          <section class="categoria" aria-labelledby={`c-${c}`}>
            <h2 id={`c-${c}`}>{NOMBRE_CATEGORIA[c]}</h2>
            {servicios.filter((s) => s.data.categoria === c).map((s) => (
              <div class="servicio-fila">
                <h3>{s.data.nombre}</h3>
                <span class="precio num">{s.data.desde && <small>desde</small>}{euros(s.data.precio)}</span>
                <p>{s.data.descripcion}</p>
              </div>
            ))}
          </section>
        ))}
      </div>
      <p class="letra-pequena" style="margin-top:24px;max-width:70ch">Precios con IVA incluido. Los de «desde» dependen de la especie, el peso y el caso. Las pruebas y las cirugías se presupuestan antes de empezar.</p>
      <p><a class="btn" href="/cita/">Pedir cita</a></p>
    </div>
  </section>
  <section class="banda banda--azul seccion"><div class="contenedor"><Preguntas tema="general" titulo="Sobre los precios" /></div></section>
</Base>
