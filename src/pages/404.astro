---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noindex>
  <section class="seccion">
    <div class="contenedor" style="max-width:760px">
      <p><span class="pegatina pegatina--rosa">Error 404</span></p>
      <h1>Esta página se ha escapado.</h1>
      <p class="texto">La página que buscas no existe o se ha movido. Vuelve al inicio, y si lo que te preocupa es tu animal, usa la guía de urgencias.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap"><a class="btn" href="/">Ir al inicio</a><a class="btn btn--rojo" href="/urgencias/">¿Es urgente?</a></div>
    </div>
  </section>
</Base>
